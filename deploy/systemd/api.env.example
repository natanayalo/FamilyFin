# Copy to /etc/familyfin/api.env and replace the example hostname.
FAMILY_FINANCE_DATA_ROOT=/var/lib/familyfin/data
FAMILY_FINANCE_API_PUBLIC_ORIGIN=https://familyfin.example-tailnet.ts.net
FAMILY_FINANCE_API_TRUSTED_HOSTS=familyfin.example-tailnet.ts.net,localhost,127.0.0.1
FAMILY_FINANCE_API_SESSION_HOURS=8
