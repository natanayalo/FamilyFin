[Unit]
Description=FamilyFin PWA production server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=familyfin-web
Group=familyfin-web
WorkingDirectory=/opt/familyfin/current/frontend
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=PORT=3000
Environment=PATH=/opt/node-v22.14.0/bin:/usr/bin:/bin
UMask=0077
ExecStart=/opt/node-v22.14.0/bin/npm run start
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/familyfin/current/frontend/.next/cache

[Install]
WantedBy=multi-user.target
