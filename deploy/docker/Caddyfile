{
	admin off
	auto_https off
	# Proxy failures must not serialize request URIs, headers or client addresses.
	log default {
		exclude http.log
	}
}
:8080 {
	header Strict-Transport-Security "max-age=31536000"
	header >Cache-Control "private, no-store"
	header -Server
	@api path /api /api/*
	handle @api {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
}
