# Install as /etc/caddy/Caddyfile after installing Caddy v2.
# Caddy is the only local HTTP entry point. Tailscale Serve proxies to its
# loopback listener; Caddy keeps the browser's Host and Origin headers intact.
:8080 {
	bind 127.0.0.1
	# Tailscale Serve terminates browser HTTPS and proxies over loopback HTTP.
	# HSTS is returned to the browser so the private origin stays HTTPS-only.
	header Strict-Transport-Security "max-age=31536000"
	header Cache-Control "private, no-store"
	header -Server

	@api path /api /api/*
	handle @api {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
